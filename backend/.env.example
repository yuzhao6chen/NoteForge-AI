APP_NAME=NoteForge-AI
DATABASE_URL=sqlite:///./noteforge.db
STORAGE_DIR=storage

# You can click "运行 Demo" in the UI without filling any API key.
# Real generation and article assessment require the keys below.

# Only "openai" is supported. It means any OpenAI-compatible Chat Completions API.
LLM_PROVIDER=openai

# Required: OpenAI, DeepSeek, Qwen, or another compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
LLM_MODEL_OPTIONS=
LLM_REQUEST_TIMEOUT=180

# DeepSeek V4 model choices shown by the frontend. If this is empty,
# NoteForge automatically shows deepseek-v4-flash and deepseek-v4-pro
# when OPENAI_BASE_URL is https://api.deepseek.com.
# LLM_MODEL_OPTIONS=deepseek-v4-flash|DeepSeek V4 Flash|速度更快，适合草稿生成,deepseek-v4-pro|DeepSeek V4 Pro|质量更高，适合文章体检和深度打磨

# Web search uses Tavily. Fill this if web search is enabled in the UI.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# If auto-revision is enabled, drafts below this score are revised once.
MIN_REVIEW_SCORE=88
